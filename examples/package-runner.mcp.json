{
  "mcpServers": {
    "finance-package-runner": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "${FINANCE_MCP_PACKAGE}",
        "finance-package-mcp"
      ],
      "env": {
        "FINANCE_PACKAGE_AUDIT_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
