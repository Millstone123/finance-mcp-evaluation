{
  "mcpServers": {
    "finance-tools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "${CLAUDE_PLUGIN_ROOT}/package-runner",
        "finance-package-mcp"
      ],
      "env": {
        "FINANCE_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}",
        "FINANCE_PACKAGE_AUDIT_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
{
  "mcpServers": {
    "finance-tools": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.mjs"],
      "env": {
        "FINANCE_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
